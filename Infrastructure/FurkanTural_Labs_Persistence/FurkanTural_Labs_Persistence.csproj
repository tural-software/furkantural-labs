<Project Sdk="Microsoft.NET.Sdk">
  <!-- Metadata -->
  <PropertyGroup>
    <Product>FurkanTural.Labs.Persistence</Product>
    <Description>EF Core context, seeding and the query-counting interceptor for the laboratories.</Description>
  </PropertyGroup>

  <!-- Assembly information -->
  <PropertyGroup>
    <AssemblyTitle>FurkanTural.Labs.Persistence</AssemblyTitle>
    <AssemblyDescription>Persistence layer for Furkan Tural's blog laboratories.</AssemblyDescription>
    <RootNamespace>FurkanTural_Labs_Persistence</RootNamespace>
  </PropertyGroup>

  <!-- Versioning -->
  <PropertyGroup>
    <Version>1.0.0</Version>
